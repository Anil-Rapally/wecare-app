PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wecare_app

# Generate a DIFFERENT random 64-character hex value for each secret.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_HMAC_SECRET=
JWT_ISSUER=wecare-api
JWT_AUDIENCE=wecare-app

# Port 587: SMTP_SECURE=false (STARTTLS). Port 465: SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WeCare <no-reply@example.com>
